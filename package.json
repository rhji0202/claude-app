{
  "name": "claude-management",
  "version": "0.1.0",
  "private": true,
  "description": "Claude 관리 시스템 모노레포 (NestJS API + Next.js UI + 공유 타입)",
  "scripts": {
    "// dev": "shared는 dist를 소비하므로 watch 시작 전에 한 번 빌드해 둔다(--parallel이라 순서 보장 안 됨)",
    "dev": "pnpm build:shared && pnpm --parallel -r dev",
    "dev:api": "pnpm build:shared && pnpm --filter @claude-app/api start:dev",
    "dev:web": "pnpm build:shared && pnpm --filter @claude-app/web dev",
    "build:shared": "pnpm --filter @claude-app/shared build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "prisma:generate": "pnpm --filter @claude-app/api prisma:generate",
    "prisma:migrate": "pnpm --filter @claude-app/api prisma:migrate"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  }
}
