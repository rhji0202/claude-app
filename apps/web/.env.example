# Claude Agent SDK 인증 (둘 중 하나)
# 1) Anthropic API 키 사용
ANTHROPIC_API_KEY=sk-ant-...

# 2) 또는 프록시/게이트웨이를 통해 라우팅 (키를 컨테이너 밖에서 주입)
# ANTHROPIC_BASE_URL=https://your-proxy.example.com

# 기본 모델 (미지정 시 SDK 기본값)
# CLAUDE_DEFAULT_MODEL=claude-sonnet-5

# GitHub 연동 (이슈 처리 모듈에서 사용)
# 이슈 목록/상세 조회, 코멘트 작성에 사용. repo 스코프 권장.
GITHUB_TOKEN=ghp_...
# GitHub Enterprise 사용 시 API 베이스 URL (기본: https://api.github.com)
# GITHUB_API_URL=https://github.example.com/api/v3
