# NestJS API 베이스 URL (기본: http://localhost:3001/api)
# 브라우저가 직접 호출하는 주소이므로 외부에서 접근 가능한 값이어야 한다.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# next.config.js의 /api/* rewrite가 넘길 API 주소 (기본: http://127.0.0.1:3001)
# 같은 오리진으로 들어온 /api/* 를 프록시할 때만 쓰인다. API 포트를 바꿨다면
# 여기도 맞춰야 그 경로가 502로 죽지 않는다. (예: 운영 http://127.0.0.1:7100)
# API_PROXY_TARGET=http://127.0.0.1:3001
