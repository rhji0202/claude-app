// Claude 관리 시스템 데이터 모델
// 시크릿(anthropicApiKey, gitToken)은 AES-256-GCM으로 암호화해 *Enc 컬럼에 저장한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PRIVATE
  SHARED
  PUBLIC
}

enum IssueStatus {
  QUEUED
  RUNNING
  DONE
  ERROR
  INTERRUPTED
}

enum IssueSource {
  GITHUB
  MANUAL
}

enum CronStatus {
  OK
  ERROR
}

enum SkillScope {
  GLOBAL
  PROJECT
}

enum McpType {
  STDIO
  HTTP
  SSE
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

// 전역(시스템) 역할 — 프로젝트 단위 Role과 별개.
enum GlobalRole {
  ADMIN
  MEMBER
}

enum ShareLinkScope {
  READ
  ISSUE_REPORT
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  name          String?
  passwordHash  String
  role          GlobalRole      @default(MEMBER)
  disabled      Boolean         @default(false)
  ownedProjects Project[]       @relation("Owns")
  shares        ProjectShare[]
  claudeAccounts ClaudeAccount[]
  chatSessions  ChatSession[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// Claude(Anthropic) OAuth 계정. accessToken/refreshToken은 암호화 저장.
model ClaudeAccount {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label            String
  accessTokenEnc   String
  refreshTokenEnc  String?
  expiresAt        DateTime?
  scopes           String[]
  accountEmail     String?
  subscriptionType String?
  isActive         Boolean   @default(false)
  projects         Project[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatSession {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String?
  sdkSessionId String?
  messages     ChatMessage[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@index([projectId])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String
  // 순서 있는 파트 타임라인(text/tool). assistant 메시지에만 존재.
  parts     Json?
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?
  cwd         String

  // 프로젝트별 git 연결
  gitRepo   String?
  gitBranch String?

  // 이슈 실행 시 에이전트가 변경을 브랜치 push + PR로 만들지 여부(gh CLI 사용).
  // false면 기존처럼 텍스트 요약만 남긴다.
  autoPr    Boolean @default(false)
  // PR 생성 후 자동 머지까지 진행할지(gh pr merge --auto). autoPr가 true일 때만 의미 있음.
  autoMerge Boolean @default(false)

  // 프로젝트별 자격증명 (암호화 저장)
  gitTokenEnc String?

  // 프로젝트가 사용할 Claude 계정(선택). 미지정 시 실행 사용자 활성 계정 → .env 폴백.
  claudeAccountId String?
  claudeAccount   ClaudeAccount? @relation(fields: [claudeAccountId], references: [id], onDelete: SetNull)

  // 소유 / 공개 범위
  ownerId    String?
  owner      User?      @relation("Owns", fields: [ownerId], references: [id], onDelete: SetNull)
  visibility Visibility @default(PRIVATE)

  shares       ProjectShare[]
  shareLinks   ShareLink[]
  mcpServers   ProjectMcpServer[]
  skills       ProjectSkill[]
  issueTasks   IssueTask[]
  cronJobs     CronJob[]
  chatSessions ChatSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IssueTask {
  id          String      @id @default(uuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repo        String
  issueNumber Int?
  title       String
  body        String?
  url         String?
  labels      String[]
  author      String?
  source      IssueSource @default(GITHUB)
  prompt      String?
  // 첨부 이미지 저장 상대경로 목록 (UPLOADS_DIR 기준, 예 issue-images/<id>/a.png)
  images      String[]
  status      IssueStatus @default(QUEUED)
  sessionId   String?
  result      String?
  error       String?
  resultCommentUrl String?
  // autoPr 실행 시 에이전트가 만든 PR URL (있으면 프론트에 링크 표시)
  prUrl       String?
  // 큐/워커: 재시도 횟수, 워커가 집은 시각(stale 회수용), 집은 워커 인스턴스 id(다중 워커 대비)
  attempts    Int         @default(0)
  claimedAt   DateTime?
  lockedBy    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId])
  @@index([status])
}

model CronJob {
  id         String      @id @default(uuid())
  name       String
  schedule   String
  prompt     String
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  enabled    Boolean     @default(true)
  lastRunAt  DateTime?
  lastResult String?
  lastStatus CronStatus?
  runs       CronRun[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([projectId])
}

// 크론 실행 이력(누적). 최근 N건만 보관하고 오래된 것은 워커가 자동 정리한다.
model CronRun {
  id         String      @id @default(uuid())
  cronJobId  String
  cronJob    CronJob     @relation(fields: [cronJobId], references: [id], onDelete: Cascade)
  status     CronStatus? // 진행 중이면 null, 종료 시 OK/ERROR
  result     String?     // 성공 결과 텍스트
  error      String?     // 실패 사유
  sessionId  String?     // 에이전트 세션 id(추후 추적·재개용)
  durationMs Int?        // 실행 소요(ms)
  startedAt  DateTime    @default(now())
  finishedAt DateTime?

  @@index([cronJobId, startedAt])
}

model Skill {
  id          String         @id @default(uuid())
  name        String
  description String
  content     String
  scope       SkillScope     @default(PROJECT)
  enabled     Boolean        @default(true)
  projects    ProjectSkill[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model McpServer {
  id        String             @id @default(uuid())
  name      String
  type      McpType
  command   String?
  args      String[]
  url       String?
  // 시크릿 값을 포함할 수 있는 env는 JSON으로 저장(값 암호화는 서비스 계층에서 처리)
  env       Json?
  enabled   Boolean            @default(true)
  projects  ProjectMcpServer[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

// M:N 조인 - 스킬/ MCP 서버를 여러 프로젝트가 공유
model ProjectSkill {
  projectId String
  skillId   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
}

model ProjectMcpServer {
  projectId   String
  mcpServerId String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  server      McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)

  @@id([projectId, mcpServerId])
}

// 팀원 공유 (멀티유저)
model ProjectShare {
  projectId String
  userId    String
  role      Role    @default(VIEWER)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

// 공유 링크 (로그인 없이 스코프된 접근 - 테스터 이슈 등록 등)
model ShareLink {
  id        String         @id @default(uuid())
  token     String         @unique
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scope     ShareLinkScope @default(READ)
  expiresAt DateTime?
  createdAt DateTime       @default(now())

  @@index([projectId])
}
