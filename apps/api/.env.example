# NestJS API 환경변수
NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/claude_management?schema=public

# 자격증명 암호화 마스터 키 (32바이트 base64): openssl rand -base64 32
ENCRYPTION_KEY=

# JWT (32자 이상 필수): openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 활성 Claude 계정이 없을 때 폴백으로 쓸 OAuth 토큰 (선택, sk-ant-oat...)
ANTHROPIC_OAUTH_TOKEN=
# 실행 기본 모델(계정별 지정이 없을 때). claude-opus-5 또는 alias opus/sonnet/haiku.
# 선택 가능: claude-opus-5 / claude-fable-5 / claude-sonnet-5 / claude-opus-4-8 / claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-5
# 실행 기본 reasoning effort. low|medium|high|xhigh|max.
ANTHROPIC_EFFORT=high

# CORS 허용 오리진 (쉼표 구분), 미설정 시 모두 허용
WEB_ORIGIN=http://localhost:3000

# 부팅 시 admin으로 승격할 이메일(쉼표 구분) — 첫 관리자 부트스트랩
ADMIN_EMAILS=

# 업로드(이슈 이미지) 저장 루트 (미설정 시 apps/api/uploads)
UPLOADS_DIR=

# ---- 이슈 큐/워커 ----
# 동시 실행 에이전트 수 상한 (= 워커가 동시에 클레임하는 이슈 수)
AGENT_CONCURRENCY=3
# 워커 폴링 주기(ms). 0 이하면 폴링 비활성.
ISSUE_WORKER_POLL_MS=5000
# 실패/중단 이슈 자동 재시도 최대 횟수
ISSUE_MAX_RETRY=2
# 이슈 실행 최대 턴 수(에이전트 왕복). 넉넉히 잡아 한 실행에 조사+수정+요약이 끝나게.
ISSUE_MAX_TURNS=300
# stale 클레임 회수 임계(ms). RUNNING인데 이 시간 넘게 갱신 없으면 INTERRUPTED로 회수.
# maxTurns가 크면 실행이 길어지므로 넉넉히(기본 30분).
ISSUE_STALE_MS=1800000
# per-run worktree 루트 (미설정 시 apps/api/worktrees)
ISSUE_WORKTREE_ROOT=
# 시스템 관리 clone 루트 (미설정 시 apps/api/repos). UPLOADS_DIR와 분리 필수(정적 노출 방지).
REPOS_DIR=
