# NestJS API 환경변수
NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/claude_management?schema=public

# 자격증명 암호화 마스터 키 (32바이트 base64): openssl rand -base64 32
ENCRYPTION_KEY=

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# 프로젝트가 자체 키를 갖지 않을 때 폴백으로 쓸 Anthropic 키 (선택)
ANTHROPIC_API_KEY=

# CORS 허용 오리진 (쉼표 구분), 미설정 시 모두 허용
WEB_ORIGIN=http://localhost:3000
